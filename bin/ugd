#!/usr/bin/env bash
# universal-gamedev CLI launcher. Works from a clone, a plugin install, or a PATH symlink.
#   ugd scan . | ugd kb search godot | ugd release check . | ugd shot diff golden.png actual.png
# Uses uv when available (it creates the project's .venv with PyYAML + Pillow on first run);
# otherwise the system python3, which then needs `pip install pyyaml pillow`.
set -euo pipefail
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"
if command -v uv >/dev/null 2>&1 && [ -z "${UGD_NO_UV:-}" ]; then
  exec uv run --quiet --project "$ROOT" python -m ugd "$@"
fi
PY="$(command -v python3 || command -v python)"
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m ugd "$@"
