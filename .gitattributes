* text=auto
# Shell scripts must keep LF on every OS, or Git Bash and Unix shells choke on the \r
*.sh      text eol=lf
bin/ugd   text eol=lf
bin/um    text eol=lf
# Batch files need CRLF: cmd.exe's label parsing (goto) misbehaves with LF
*.cmd     text eol=crlf
*.bat     text eol=crlf
# Binary assets
*.png     binary
*.jpg     binary
*.gif     binary
*.glb     binary
*.ttf     binary
